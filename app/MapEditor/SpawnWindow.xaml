<Window x:Class="MapEditor.SpawnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spawn points" Width="400" Height="480" MinWidth="320" MinHeight="240"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button x:Name="RestoreButton" DockPanel.Dock="Right" Content="Restore originals" Padding="10,3"
                    ToolTip="Replaces all play points with the spawn points of the original world (the test point stays). Heights are adjusted to today's ground."/>
            <TextBlock x:Name="CountText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Text="SPAWN POINTS"/>
        </DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6,0,30,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="Type"/>
            <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="Position (x, z)"/>
            <TextBlock Grid.Column="2" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" Text="Height"/>
            <TextBlock Grid.Column="3" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Right" Text="View"/>
        </Grid>
        <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,0,0"
                   Text="Click a row: the map jumps there. Trash can: delete the spawn point (undo with Ctrl+Z)."/>
        <ListBox x:Name="SpawnList" BorderThickness="1" BorderBrush="{DynamicResource SoftLineBrush}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
</Window>
