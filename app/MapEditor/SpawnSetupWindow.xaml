<Window x:Class="MapEditor.SpawnSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:MapEditor"
        Title="Create spawn points" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <!-- Menu rebuild 2026-11-20 (the user's request): choose the seed and the number of the spawn points; reset button for the number -->
    <StackPanel Margin="{StaticResource WindowPadding}">
        <TextBlock Style="{StaticResource FormTitle}" Text="Spawn points for playing"/>
        <Border Style="{StaticResource FormBox}" Margin="0">
            <StackPanel>
                <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Seed"/>
                    <TextBox x:Name="SeedBox" Width="150" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0" DockPanel.Dock="Left"/>
                    <Button Style="{StaticResource FormButton}" Click="RandomSeed_Click" ToolTip="New random seed – same seed = same spawn points">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Dice5}"/><TextBlock Text="Random" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </DockPanel>
                <DockPanel Style="{StaticResource FormRow}">
                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Number"/>
                    <TextBox x:Name="CountBox" Width="64" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0" DockPanel.Dock="Left"/>
                    <Button Style="{StaticResource FormButton}" Click="ResetCount_Click" ToolTip="Back to the default number">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowCounterclockwise}"/><TextBlock Text="Reset" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </DockPanel>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource FormHint}" Text="The play points are replaced; the test point stays. This is saved right away."/>
        <DockPanel Margin="{StaticResource DialogFooterMargin}">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="260"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"/>
                <Button Style="{StaticResource DialogButton}" FontWeight="SemiBold" IsDefault="True" Content="Create" Click="Ok_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
