<Window x:Class="MapEditor.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to YAMEE" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- first start on a PC (the user's request 2026-10-30): shows what was found; "Looks good" is usually enough -->
    <StackPanel Margin="{StaticResource WindowPadding}">
        <TextBlock Style="{StaticResource FormTitle}" FontSize="16" Text="Welcome to YAMEE"/>
        <TextBlock Style="{StaticResource FormIntro}" Margin="0,0,0,14"
                   Text="YAMEE has looked for 7 Days to Die and its worlds. Please check the folders and click &quot;Looks good&quot;. Everything can be changed later in the settings."/>

        <TextBlock Style="{StaticResource FormTitle}" Text="7 Days to Die (game folder)"/>
        <DockPanel>
            <Button x:Name="GameBrowse" DockPanel.Dock="Right" Style="{StaticResource FormButton}" Content="Browse …"/>
            <TextBox x:Name="GameBox" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0"/>
        </DockPanel>
        <TextBlock x:Name="GameInfo" Style="{StaticResource FormNote}" Margin="0,4,0,14" Text=""/>

        <TextBlock Style="{StaticResource FormTitle}" Text="Worlds of the game (GeneratedWorlds)"/>
        <TextBlock x:Name="WorldsInfo" Style="{StaticResource FormNote}" Margin="0,4,0,14" Text=""/>

        <TextBlock Style="{StaticResource FormTitle}" Text="Project folder (worlds, backups and settings)"/>
        <DockPanel>
            <Button x:Name="ProjectBrowse" DockPanel.Dock="Right" Style="{StaticResource FormButton}" Content="Browse …"/>
            <TextBox x:Name="ProjectBox" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0"/>
        </DockPanel>
        <TextBlock Style="{StaticResource FormNote}" Margin="0,4,0,14"
                   Text="YAMEE never changes a world in the game directly: it works on a copy here and writes it back with &quot;Copy to 7 Days to Die&quot;."/>

        <TextBlock Style="{StaticResource FormTitle}" Text="Language"/>
        <ComboBox x:Name="LanguageBox" Style="{StaticResource FormCombo}" Width="180" HorizontalAlignment="Left"/>

        <TextBlock x:Name="ErrorText" Margin="{StaticResource DialogFooterMargin}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterMargin}">
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Content="Looks good" FontWeight="SemiBold" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
