<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MapEditor</RootNamespace>
    <AssemblyName>YAMEE</AssemblyName>
    <Product>YAMEE – Yet Another Map Editor Extra</Product>
    <!-- Icon of the exe (taskbar, title bar, start menu); created from yamee_icon.svg with tools\render_logo.ps1 -->
    <ApplicationIcon>Assets\yamee.ico</ApplicationIcon>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Editions: default = development build (DEV); publish.bat builds Release (installer) or Portable (PORTABLE) -->
  <PropertyGroup Condition="'$(YameeEdition)' != 'Release' and '$(YameeEdition)' != 'Portable'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(YameeEdition)' == 'Portable'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF leaves System.IO out of the implicit usings (name clash with Path from WPF) -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language files next to YAMEE.exe (Languages\German.ini …) -->
    <None Include="Languages\*.ini" CopyToOutputDirectory="PreserveNewest" />
    <!-- Map export (Home › Export › "Map as .zip"): install guide templates from Guide\ and the bridge mod from bridges\ → Export\ next to YAMEE.exe -->
    <None Include="..\..\Guide\Map_Install_and_Features_*.md" Link="Export\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\bridges\YAMEE_Bridges\**\*" Link="Export\YAMEE_Bridges\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo and icon, embedded in the exe -->
    <Resource Include="Assets\yamee_logo.png" />
    <Resource Include="Assets\yamee.ico" />
    <!-- Icon font Bootstrap Icons (MIT, license alongside); characters as Icon.* in Icons.cs, generated with tools\make_icon_names.ps1 -->
    <Resource Include="Assets\bootstrap-icons.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- the test project (app\YAMEE.Tests) may check internal parts such as the undo data -->
    <InternalsVisibleTo Include="YAMEE.Tests" />
  </ItemGroup>

</Project>
