                                    <TextBox x:Name="AsphaltTolBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Cross slope up to (%)"
                                               ToolTip="How far the new road may tilt sideways at junctions (0 = always level)"/>
                                    <TextBox x:Name="AsphaltCrossBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource FormHint}" Text="Height offset, grade and junctions: in the window above the map."/>
                            </StackPanel>
                        </DockPanel>
