                                    <TextBox x:Name="AsphaltSmoothBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Slope at least (m)"/>
                                    <TextBox x:Name="AsphaltBlendBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Slope per m of height (m, 0 = off)"/>
                                    <TextBox x:Name="AsphaltCutBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Junction flat up to (%)"
