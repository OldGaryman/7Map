                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelGroupLabel}" Text="Gravel"/><Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource FormButton}" Tag="gravel" Click="ResetTool_Click" ToolTip="Load the values of this tool from default.ini (your changes in user.ini are removed)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowRepeat}"/><TextBlock Text="Reset values" Margin="6,0,0,0"/></StackPanel></Button>
                            <StackPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Width of the area (m)"/>
                                    <TextBox x:Name="GravelWidthBox" Style="{StaticResource FormField}" Text="5" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}" ToolTip="Extra strip per side, levelled to the road height but without any surface. Useful for roads that climb a mountain or cut into the ground.">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Grass edge (m)"/>
                                    <TextBox x:Name="GravelGrassBox" Style="{StaticResource FormField}" Text="0" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Maximum grade (%)"/>
                                    <TextBox x:Name="GravelGradeBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Smoothing of the course (m)"/>
                                    <TextBox x:Name="GravelSmoothBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Slope at least (m)"/>
                                    <TextBox x:Name="GravelBlendBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Slope per m of height (m, 0 = off)"/>
                                    <TextBox x:Name="GravelCutBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Junction flat up to (%)"
                                               ToolTip="Up to this grade a junction counts as flat; steeper existing roads are adjusted to this value at the junction"/>
                                    <TextBox x:Name="GravelTolBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource FormRow}">
                                    <TextBlock Style="{StaticResource FormLabelWide}" Text="Cross slope up to (%)"
                                               ToolTip="How far the new road may tilt sideways at junctions (0 = always level)"/>
                                    <TextBox x:Name="GravelCrossBox" Style="{StaticResource FormField}" LostFocus="ToolValue_Changed" KeyDown="ToolValue_KeyDown"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource FormHint}" Text="Height offset, grade and junctions: in the window above the map."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="GroupRoadEdit" Style="{StaticResource PanelGroup}" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelGroupLabel}" Text="Edit road"/><Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource FormButton}" Tag="roadedit" Click="ResetTool_Click" ToolTip="Load the values of this tool from default.ini (your changes in user.ini are removed)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowRepeat}"/><TextBlock Text="Reset values" Margin="6,0,0,0"/></StackPanel></Button>
                            <TextBlock Style="{StaticResource FormText}"
                                       Text="Click onto an existing road: the marker snaps to the middle of the road. With two or more markers you can change the height, the grade and the banking in the window above the map."/>
                        </DockPanel>
                    </Border>
                    <Border x:Name="GroupEraser" Style="{StaticResource PanelGroup}" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelGroupLabel}" Text="Eraser"/><Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource FormButton}" Tag="eraser" Click="ResetTool_Click" ToolTip="Load the values of this tool from default.ini (your changes in user.ini are removed)"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowRepeat}"/><TextBlock Text="Reset values" Margin="6,0,0,0"/></StackPanel></Button>
                            <StackPanel>
                                <StackPanel>
                                    <DockPanel Style="{StaticResource FormRow}">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Brush shape"/>
                                        <RadioButton Style="{StaticResource FormRadio}" x:Name="BrushRoundRadio" Content="Round" IsChecked="True" Click="BrushShape_Click"/>
                                        <RadioButton Style="{StaticResource FormRadio}" x:Name="BrushSquareRadio" Content="Square" Click="BrushShape_Click"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource FormRow}">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Brush size (m)"/>
                                        <TextBox x:Name="BrushSizeBox" Style="{StaticResource FormField}" Text="32" LostFocus="BrushSize_Changed" KeyDown="BrushSize_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource FormRow}">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Bumpiness"/>
                                        <ComboBox Style="{StaticResource FormCombo}" x:Name="BumpsBox" SelectedIndex="2" SelectionChanged="BumpsBox_SelectionChanged"
                                                  ToolTip="How bumpy the erased ground becomes. The ground is always blended into the terrain next to it; &quot;None&quot; = smooth">
                                            <ComboBoxItem Content="None"/>
                                            <ComboBoxItem Content="Light"/>
                                            <ComboBoxItem Content="Medium"/>
                                            <ComboBoxItem Content="Strong"/>
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Breite am rechten Rand ziehbar -->
            <Thumb HorizontalAlignment="Right" Width="6" Cursor="SizeWE" DragDelta="LeftPanelThumb_DragDelta" DragCompleted="LeftPanelThumb_DragCompleted"
                   ToolTip="Drag to change the width">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                </Thumb.Template>
