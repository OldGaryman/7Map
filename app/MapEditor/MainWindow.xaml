                <ToggleButton x:Name="MtnHillButton" Tag="2" Click="MountainKind_Click"/>
                <ToggleButton x:Name="MtnDomeButton" Tag="3" Click="MountainKind_Click"/>
                <ToggleButton x:Name="BiomeTool" Click="BiomeTool_Click"/>
                <ToggleButton x:Name="RngMountainButton" Tag="0" Click="RangeKind_Click"/>
                <ToggleButton x:Name="RngHillsButton" Tag="1" Click="RangeKind_Click"/>
                <ToggleButton x:Name="RngHighlandButton" Tag="2" Click="RangeKind_Click"/>
                <ToggleButton x:Name="AsphaltTool" Click="AsphaltTool_Click"/>
                <ToggleButton x:Name="GravelTool" Click="GravelTool_Click"/>
                <ToggleButton x:Name="RoadEditTool" Click="RoadEditTool_Click"/>
                <ToggleButton x:Name="EraserTool" Click="EraserTool_Click"/>
                <ToggleButton x:Name="MountainTool" Click="MountainTool_Click"/>
                <ToggleButton x:Name="RangeTool" Click="RangeTool_Click"/>
                <ToggleButton x:Name="WaterTool" Click="WaterTool_Click"/>
                <ToggleButton x:Name="WaterLakeButton" Tag="0" Click="WaterKind_Click"/>
                <ToggleButton x:Name="WaterDryButton" Tag="1" Click="WaterKind_Click"/>
                <ToggleButton x:Name="WaterRiverButton" Tag="2" Click="WaterKind_Click"/>
                <ToggleButton x:Name="WaterCraterButton" Tag="3" Click="WaterKind_Click"/>
            </StackPanel>
            </Grid>
        </Border>

        <!-- Rechte Seite: Gebäudeliste mit Gruppen (Klick öffnet das Fenster „Gebäude“); Breite am linken Rand ziehbar -->
        <Border x:Name="RightPanel" DockPanel.Dock="Right" Width="380" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <Grid>
            <DockPanel x:Name="RightPanelFull">
            <Thumb DockPanel.Dock="Left" Width="6" Cursor="SizeWE" DragDelta="RightPanelThumb_DragDelta" DragCompleted="RightPanelThumb_DragCompleted"
                   ToolTip="Drag to change the width">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <DockPanel Margin="4,10,10,10" Grid.IsSharedSizeScope="True">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Padding="7,2" Click="RightPanelToggle_Click" ToolTip="Fold the list away to the right">
                        <TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ChevronDoubleRight}"/>
                    </Button>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="BUILDINGS"/>
                </DockPanel>
                <WrapPanel x:Name="CategoryBar" DockPanel.Dock="Top" Margin="0,0,0,4"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <CheckBox x:Name="AllPrefabsCheck" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Content="all from the game" Click="AllPrefabsCheck_Click"
                              ToolTip="Off: only buildings on this map. On: all buildings from the game and the mods"/>
                    <TextBox x:Name="PrefabSearch" Padding="4,2" TextChanged="PrefabSearch_TextChanged" ToolTip="Search by name"/>
                </DockPanel>
                <!-- Filter nach Biom: zeigt, was das Spiel in diesem Biom baut (Wunsch des Nutzers 5.11.2026) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="Biome:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SubtleTextBrush}"/>
                    <ComboBox x:Name="BiomeFilterBox" SelectionChanged="BiomeFilter_Changed" ToolTip="Show only what the game builds in this biome (buildings without a district are hidden then)"/>
                </DockPanel>


                <TextBlock x:Name="PrefabCountText" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4" Text=""/>
                <!-- Spaltenköpfe zum Sortieren (Wunsch des Nutzers 31.10.2026), gleiche Spalten wie die Einträge -->
                <Grid DockPanel.Dock="Top" Margin="6,0,24,2" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource SubtleTextBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PrefabExits"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="PrefabCount"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SortTierHead" Tag="tier" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SortHead_Click" ToolTip="Click to sort, click again to reverse"/>
                    <TextBlock x:Name="SortNameHead" Grid.Column="1" Tag="name" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SortHead_Click" ToolTip="Click to sort, click again to reverse"/>
                    <TextBlock Grid.Column="2" Text="Biome" ToolTip="Biomes in which the game builds it (F pine forest, B burnt forest, D desert, S snow, W wasteland, * all)"/>
                    <TextBlock x:Name="SortCountHead" Grid.Column="4" HorizontalAlignment="Right" Tag="count" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="SortHead_Click" ToolTip="Click to sort, click again to reverse"/>
                </Grid>
                <ListBox x:Name="PrefabList" HorizontalContentAlignment="Stretch" BorderBrush="{DynamicResource SoftLineBrush}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PrefabList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Stufe vorne in eigener Spalte (Wunsch des Nutzers: lange Namen verdecken sie nicht mehr) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PrefabExits"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="PrefabCount"/>
                                </Grid.ColumnDefinitions>
                                <!-- Stufe als Sterne (Wunsch des Nutzers 31.10.2026), ohne Stufe leer -->
                                <TextBlock Text="{Binding TierText}" Foreground="#D99A00" FontFamily="Segoe UI Symbol" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding TierToolTip}"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource IconText}" Text="{Binding Icon}" MinWidth="16" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Display}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="3" Text="{Binding BiomeText}" ToolTip="{Binding BiomeToolTip}" Foreground="#3E9A5A" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding ExitsText}" ToolTip="{Binding ExitsToolTip}" Foreground="#2F6FB5" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding CountText}" Foreground="{DynamicResource SubtleTextBrush}" Margin="8,0,0,0" MinWidth="24" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </DockPanel>
            <!-- eingeklappt: schmaler Streifen mit Knopf zum Aufklappen -->
            <Button x:Name="RightPanelStrip" Visibility="Collapsed" Margin="3" Padding="0,10" Click="RightPanelToggle_Click" ToolTip="Show the building list">
                <StackPanel>
                    <TextBlock Style="{StaticResource IconText}" HorizontalAlignment="Center" Text="{x:Static ic:Icons.ChevronDoubleLeft}"/>
                    <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Text="BUILDINGS">
                        <TextBlock.LayoutTransform><RotateTransform Angle="90"/></TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>
            </Button>
            </Grid>
        </Border>

        <!-- Höhenprofil: nur sichtbar, solange eine Straße mit Profil berechnet ist (ShowProfile) -->
        <Border x:Name="ProfilePanel" DockPanel.Dock="Bottom" Height="190" Visibility="Collapsed" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <c:ProfileChart x:Name="Profile"/>
        </Border>

        <DockPanel>
            <!-- Lineale (Ansicht → Lineale): Meter vom Kartenmittelpunkt, Osten nach rechts, Norden nach oben -->
            <Grid x:Name="RulerTopRow" DockPanel.Dock="Top" Height="22" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1"/>
                <c:MapRuler x:Name="RulerTop" Grid.Column="1"/>
            </Grid>
            <c:MapRuler x:Name="RulerLeft" DockPanel.Dock="Left" Width="22" Vertical="True" Visibility="Collapsed"/>
        <Grid>
            <c:MapView x:Name="Map"/>
            <!-- Legende der Biomfarben (nur sichtbar mit Häkchen „Biomes“) -->
            <Border x:Name="BiomeLegend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,8" IsHitTestVisible="False"
                    Background="{DynamicResource LegendBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Biomes" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel x:Name="BiomeLegendList"/>
                </StackPanel>
            </Border>
            <!-- Modul beim Bearbeiten: Abbrechen (Esc) oder Übernehmen -->
            <Grid x:Name="ToolModule" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" MaxWidth="620" UseLayoutRounding="True" SnapsToDevicePixels="True"
                  MouseLeftButtonDown="ToolModule_MouseDown" MouseMove="ToolModule_MouseMove" MouseLeftButtonUp="ToolModule_MouseUp">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ToolModuleShift"/>
                </Grid.RenderTransform>
                <!-- Schatten: eigene Fläche ohne Text -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="8" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button x:Name="ToolCancelButton" Content="Cancel (Esc)" Padding="14,5" Margin="0,0,8,0" Click="ToolCancel_Click"/>
                        <Button x:Name="ToolApplyButton" Content="Apply" Padding="14,5" FontWeight="SemiBold" Click="ToolApply_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="{x:Static ic:Icons.GripVertical}" FontSize="18" Foreground="{DynamicResource DisabledTextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="SizeAll"
                               ToolTip="Move the box: grab here or at an empty spot and drag"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ToolTitle" FontWeight="SemiBold" FontSize="14" Text=""/>
                        <TextBlock x:Name="ToolHint" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Text=""/>
                    </StackPanel>
                </DockPanel>
                <Border x:Name="ToolWarnBox" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6" Background="{DynamicResource NoteBrush}" BorderBrush="{DynamicResource NoteBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="ToolWarnText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <!-- Höhe der Straße: Versatz für die ganze Straße, Höhe des gewählten Punkts -->
                <Border x:Name="RoadHeightPanel" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource SoftLineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel Style="{StaticResource FormRowFill}">
                            <TextBlock Style="{StaticResource FormLabelWide}" Text="Height offset"/>
                            <TextBox x:Name="OffsetBox" Style="{StaticResource FormField}" Text="0" LostFocus="OffsetBox_Changed" KeyDown="OffsetBox_KeyDown" ToolTip="e.g. 2 or -2 (up to ±20 m)"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                            <Slider x:Name="OffsetSlider" Style="{StaticResource FormSlider}" Minimum="-10" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="OffsetSlider_ValueChanged" ToolTip="Whole road higher (+) or lower (−) than the terrain; connections to tiles and buildings stay"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="Automatic (auto): 4 m level at city tiles and building driveways, otherwise none. Or enter metres: so many metres at the start and end the road stays level">
                            <TextBlock Style="{StaticResource FormLabelWide}" Text="Keep level at start"/>
                            <TextBox x:Name="FlatStartBox" Style="{StaticResource FormField}" Text="auto" LostFocus="FlatBox_Changed" KeyDown="FlatBox_KeyDown"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}" ToolTip="Automatic (auto): 4 m level at city tiles and building driveways, otherwise none. Or enter metres: so many metres at the start and end the road stays level">
                            <TextBlock Style="{StaticResource FormLabelWide}" Text="Keep level at end"/>
                            <TextBox x:Name="FlatEndBox" Style="{StaticResource FormField}" Text="auto" LostFocus="FlatBox_Changed" KeyDown="FlatBox_KeyDown"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                        </DockPanel>
                        <DockPanel x:Name="PointHeightRow" Style="{StaticResource FormRowFill}">
                            <TextBlock x:Name="PointLabel" Style="{StaticResource FormLabelWide}" Text="Point"/>
                            <TextBox x:Name="PointHeightBox" Style="{StaticResource FormField}" LostFocus="PointHeight_Changed" KeyDown="PointHeight_KeyDown" ToolTip="Height of the road at this point (Enter = apply)"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                            <Button Style="{StaticResource FormButton}" Content="automatic" Click="PointAuto_Click" ToolTip="Calculate the height of this point from the terrain again"/>
                            <TextBlock x:Name="PointInfo" Style="{StaticResource FormInfo}" Text=""/>
                        </DockPanel>
                        <DockPanel x:Name="PointWidthRow" Style="{StaticResource FormRowFill}" Visibility="Collapsed">
                            <TextBlock x:Name="PointWidthLabel" Style="{StaticResource FormLabelWide}" Text="Road width here"/>
                            <TextBox x:Name="PointWidthBox" Style="{StaticResource FormField}" LostFocus="PointWidth_Changed" KeyDown="PointWidth_KeyDown" ToolTip="Width of the road at this point (Enter = apply). Between two points with different widths the road narrows or widens smoothly."/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                            <Button Style="{StaticResource FormButton}" Content="automatic" Click="PointWidthAuto_Click" ToolTip="Use the standard width (or the width of the connection) at this point again"/>
                            <TextBlock x:Name="PointWidthInfo" Style="{StaticResource FormInfo}" Text=""/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <CheckBox x:Name="UniformGradeCheck" Style="{StaticResource FormCheck}" Click="UniformGrade_Click" Content="Even grade (start to end, independent of the terrain)" ToolTip="The road rises or falls evenly from start to end (along the route, also through curves) instead of following the terrain. Fixed points (connections, junctions, heights set by hand) split it into sections with an even grade each."/>
                        </DockPanel>
                        <TextBlock x:Name="PointTip" Style="{StaticResource FormNote}" Text="Tip: click a point (don't drag) to set its height by hand."/>
                        <DockPanel Style="{StaticResource FormRow}">
                            <CheckBox x:Name="AdjustJunctionsCheck" Style="{StaticResource FormCheck}" IsChecked="True" Click="AdjustJunctions_Click" Content="Make junctions with existing roads flat (the existing road is adjusted)" ToolTip="If the road starts or ends on an existing road, the junction becomes almost flat (at most 2 %); if the existing road is steeper there, it is adjusted for about 70 m to each side (purple)"/>
                        </DockPanel>
                        <TextBlock x:Name="JunctionText" Style="{StaticResource FormNote}" Foreground="{DynamicResource PurpleTextBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <!-- Vorhandene Straße bearbeiten: Höhe der gewählten Markierung, Neigung bis zu ihr, Kreuzungen -->
                <Border x:Name="RoadEditPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource SoftLineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <DockPanel x:Name="EditHeightRow" Style="{StaticResource FormRowFill}">
                            <TextBlock x:Name="EditMarkerLabel" Style="{StaticResource FormLabelWide}" Text="Marker"/>
                            <TextBox x:Name="EditHeightBox" Style="{StaticResource FormField}" LostFocus="EditHeight_Changed" KeyDown="EditHeight_KeyDown" ToolTip="New height of the road at this marker (Enter = apply)"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                            <Button Style="{StaticResource FormButton}" Content="unchanged" Click="EditMarkerReset_Click" ToolTip="Leave the height of this marker as it is now"/>
                            <TextBlock x:Name="EditMarkerInfo" Style="{StaticResource FormInfo}" Text=""/>
                        </DockPanel>
                        <DockPanel x:Name="EditGradeRow" Style="{StaticResource FormRowFill}">
                            <TextBlock x:Name="EditGradeLabel" Style="{StaticResource FormLabelWide}" Text="Grade"/>
                            <TextBox x:Name="EditGradeBox" Style="{StaticResource FormField}" LostFocus="EditGrade_Changed" KeyDown="EditGrade_KeyDown" ToolTip="Grade of the road between the neighbouring marker and this one (+ = rises along the order of the markers). Enter = the height of the later marker is calculated from it."/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                            <TextBlock x:Name="EditGradeInfo" Style="{StaticResource FormInfo}" Text=""/>
                        </DockPanel>
                        <DockPanel x:Name="EditCrossRow" Style="{StaticResource FormRowFill}">
                            <TextBlock Style="{StaticResource FormLabelWide}" Text="Cross slope (banking)"/>
                            <TextBox x:Name="EditCrossBox" Style="{StaticResource FormField}" LostFocus="EditCross_Changed" KeyDown="EditCross_KeyDown" ToolTip="Slope from one side of the road to the other, like the banking of a race track. + = the left side is higher (looking along the order of the markers), − = the right side is higher. Between the markers it changes smoothly; at junctions the road is flat again. Enter = apply."/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                            <Button Style="{StaticResource FormButton}" Content="unchanged" Click="EditCrossReset_Click" ToolTip="Leave the cross slope of this marker as it is now"/>
                            <TextBlock x:Name="EditCrossInfo" Style="{StaticResource FormInfo}" Text=""/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <CheckBox x:Name="EditAutoCrossCheck" Style="{StaticResource FormCheck}" Click="EditOptions_Click" Content="Automatic banking in curves" ToolTip="Only two markers are needed: the banking of the whole stretch is calculated from the curves of the road. In a curve the road tilts towards the inside (inside lower, outside higher), the tighter the curve the more; straights stay flat, at junctions the road is flat again. A banking typed in at a marker wins over the automatic one."/>
                            <TextBlock Style="{StaticResource FormUnit}" Margin="14,0,0,0" Text="up to"/>
                            <TextBox x:Name="EditAutoCrossBox" Style="{StaticResource FormField}" Margin="6,0,0,0" Text="8" IsEnabled="False" LostFocus="EditOptions_Click" KeyDown="EditAutoMax_KeyDown" ToolTip="Highest banking in tight curves (Enter = apply)"/>
                            <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <RadioButton x:Name="EditEvenRadio" Style="{StaticResource FormRadio}" GroupName="EditShape" IsChecked="True" Click="EditOptions_Click" Content="Even grade" ToolTip="The road between the markers gets an even slope; hills in between disappear"/>
                            <RadioButton x:Name="EditShapeRadio" Style="{StaticResource FormRadio}" GroupName="EditShape" Click="EditOptions_Click" Content="Keep the shape" ToolTip="The road keeps its ups and downs and is only moved higher or lower"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <CheckBox x:Name="EditKeepJunctionsCheck" Style="{StaticResource FormCheck}" Click="EditOptions_Click" Content="Keep all junctions at their old height (crossing roads stay untouched)" ToolTip="Off: crossing roads follow the change as far as they can without becoming steep (green rings); where they cannot, the junction stays at its old height by itself (orange rings). On: all junctions stay at their old height, crossing roads are not touched."/>
                        </DockPanel>
                        <TextBlock x:Name="EditInfo" Style="{StaticResource FormNote}" Foreground="{DynamicResource PurpleTextBrush}"/>
                        <TextBlock x:Name="EditWarn" Style="{StaticResource FormNote}" Foreground="{DynamicResource OrangeTextBrush}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
                </Border>
            </Grid>
            <Border x:Name="Overlay" Background="{DynamicResource OverlayBrush}">
                <TextBlock x:Name="LoadingText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" Text="Loading world …"/>
            </Border>
        </Grid>
        </DockPanel>
    </DockPanel>
</Window>
