<Window x:Class="MapEditor.RoadNetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:MapEditor"
        Title="Generate roads" Width="520" Height="880" MinHeight="420" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <!-- Create roads (the user's request 2026-11-07), stage 1: plan the network and show it on the map without changing the world.
         The window stays open beside the map (not modal) so that the preview can be looked at and planned again. -->
    <DockPanel Margin="{StaticResource WindowPadding}">
        <DockPanel DockPanel.Dock="Bottom" Margin="{StaticResource DialogFooterMargin}">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="250"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" Click="Close_Click"/>
                <Button x:Name="PlanButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="Plan_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Signpost2}"/><TextBlock Text="Plan network" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <Button x:Name="BuildButton" Style="{StaticResource DialogButton}" FontWeight="SemiBold" IsEnabled="False" Click="Build_Click"
                        ToolTip="Build the planned roads into the map (one editing step, undo with Ctrl+Z)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Hammer}"/><TextBlock Text="Build roads" Margin="6,0,0,0"/></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource FormTitle}" Text="Roads between the towns"/>
            <Border Style="{StaticResource FormBox}" Margin="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Usual gradient, up to"/>
                        <TextBox x:Name="GradeBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="In tight passages, up to"/>
                        <TextBox x:Name="MaxGradeBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cut into the ground, up to"/>
                        <TextBox x:Name="CutBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"
                                 ToolTip="Roads may lie this deep below the terrain in a cut"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Embankment, up to"/>
                        <TextBox x:Name="FillBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"
                                 ToolTip="Roads may lie this high above the terrain on an embankment. Small values keep the roads close to the ground. Steep terrain still needs more."/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cross connections"/>
                        <ComboBox x:Name="LoopsBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="Extra roads where the way over the network would be a long detour; they create crossings and junctions">
                            <ComboBoxItem Content="Few"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Many"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Curviness"/>
                        <ComboBox x:Name="CurvesBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="How much the roads swing in wide bends on flat land (in hills they follow the terrain anyway)">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Strong"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cuts through ridges"/>
                        <ComboBox x:Name="CutsBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="Some roads go straight through a ridge in a cut (up to about 20 m deep) instead of winding around it">
                            <ComboBoxItem Content="Never"/>
                            <ComboBoxItem Content="Rarely"/>
                            <ComboBoxItem Content="More often"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Node tiles"/>
                        <ComboBox x:Name="NodeTilesBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="Like in the game: gateway tiles between the towns. A trial planning first shows where junctions (T), crossings (X) and long straight stretches (I) arise; on level free places there a tile is put, and the country roads meet at its exits">
                            <ComboBoxItem Content="None"/>
                            <ComboBoxItem Content="Some"/>
                            <ComboBoxItem Content="Many"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Seed"/>
                        <TextBox x:Name="SeedBox" Width="150" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0" DockPanel.Dock="Left" TextChanged="Text_Changed"/>
                        <Button Style="{StaticResource FormButton}" Click="RandomSeed_Click" ToolTip="New random seed – same seed on the same map = same network">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Dice5}"/><TextBlock Text="Random" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <Button Style="{StaticResource FormButton}" Click="ResetValues_Click" ToolTip="Set all values of this window back to the defaults (default.ini)">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowCounterclockwise}"/><TextBlock Text="Reset values" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource FormNote}" Text="Asphalt roads 16 m wide with a 1 m gravel shoulder on each side; Old West towns get a gravel road (as wide as their exit, at most 12 m). &quot;Plan network&quot; only shows the network on the map; &quot;Build roads&quot; then builds it into the map (undo with Ctrl+Z)."/>
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="PlanUndoButton" Style="{StaticResource FormButton}" IsEnabled="False" Click="PlanUndo_Click" DockPanel.Dock="Left"
                        ToolTip="Take back the last change to the plan (Ctrl+Z while this window is open)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowCounterclockwise}"/><TextBlock Text="Undo in plan" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <Button x:Name="ShowSavedButton" Style="{StaticResource FormButton}" Visibility="Collapsed" Click="ShowSaved_Click" DockPanel.Dock="Left" Margin="8,0,0,0"
                        ToolTip="Show the saved plan of this project on the map again, to edit it and build it again">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Map}"/><TextBlock Text="Show saved plan" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <ToggleButton x:Name="DrawRoadButton" Style="{StaticResource FormToggle}" IsEnabled="False" Click="DrawRoad_Click" DockPanel.Dock="Left" Margin="8,0,0,0"
                              ToolTip="Draw a new road: click a free town exit or a planned road where it begins, then where it ends (Esc cancels)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Pencil}"/><TextBlock Text="Draw new road" Margin="6,0,0,0"/></StackPanel>
                </ToggleButton>
                <TextBlock/>
            </DockPanel>
            <TextBlock x:Name="DrawNote" Style="{StaticResource FormNote}" Visibility="Collapsed"/>
            <Border x:Name="SelectedBox" Style="{StaticResource FormBox}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource FormSection}" Text="Selected road"/>
                    <TextBlock x:Name="SelectedInfo" Style="{StaticResource FormText}" TextWrapping="Wrap"/>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Kind"/>
                        <ComboBox x:Name="KindBox" Style="{StaticResource FormCombo}" SelectionChanged="Kind_Changed">
                            <ComboBoxItem Content="Asphalt"/>
                            <ComboBoxItem Content="Gravel"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Roadway width"/>
                        <TextBox x:Name="WidthBox" Style="{StaticResource FormField}" KeyDown="WidthBox_KeyDown" LostFocus="WidthBox_LostFocus"
                                 ToolTip="Width of the roadway without the gravel shoulder (4 to 24 m, Enter takes it)"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <Button Style="{StaticResource FormButton}" Click="DeleteRoad_Click" ToolTip="Remove this road from the plan (Del)">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Trash}"/><TextBlock Text="Delete road" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <Button x:Name="ClearViaButton" Style="{StaticResource FormButton}" Click="ClearVia_Click" Margin="8,0,0,0"
                                ToolTip="Remove all via points of this road and search its course again">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowRepeat}"/><TextBlock Text="Remove via points" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBlock Style="{StaticResource FormNote}" Text="Drag the road on the map to route it past a new point (within about 30 m, the point then moves onto the road); drag a point to move it, right-click it to remove it. Only the straight piece at a town or tile exit (44 m) and the first 24 m at a junction stay; hold Alt while dragging for more freedom (24 m and 10 m). The road never crosses itself."/>
                    <TextBlock x:Name="RouteNote" Style="{StaticResource FormNote}" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border x:Name="TileBox" Style="{StaticResource FormBox}" Margin="0,10,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource FormSection}" Text="Selected node tile"/>
                    <TextBlock x:Name="TileInfo" Style="{StaticResource FormText}" TextWrapping="Wrap"/>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Kind"/>
                        <ComboBox x:Name="TileKindBox" Style="{StaticResource FormCombo}" SelectionChanged="TileKind_Changed"
                                  ToolTip="Exchange the tile: its roads go to the exits that point their way, exits without a road stay free (orange) – you can draw a new road from them">
                            <ComboBoxItem Content="Crossing (X)"/>
                            <ComboBoxItem Content="T junction (T)"/>
                            <ComboBoxItem Content="Straight gateway (I)"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <Button Style="{StaticResource FormButton}" Click="TurnTile_Click" ToolTip="Turn the tile by 90° clockwise; its roads are led to the turned exits">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.ArrowClockwise}"/><TextBlock Text="Turn 90°" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource FormNote}" Text="Drag the tile on the map to move it, its roads follow. Blue points = connection points with a road, orange = free connection point."/>
                    <TextBlock x:Name="TileNote" Style="{StaticResource FormNote}" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource FormTitle}" Margin="0,14,0,6" Text="Result"/>
        </StackPanel>

        <Border Style="{StaticResource FormBox}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- legend of the preview, structured and at the top (the user's request 2026-11-26); the colours are the fixed map colours of MapView -->
                    <StackPanel x:Name="LegendBox" Visibility="Collapsed" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FormSection}" Text="On the map"/>
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="22" Height="5" Fill="#23232D" VerticalAlignment="Center"/><TextBlock Text="Asphalt road" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="22" Height="5" Fill="#7D2DAF" VerticalAlignment="Center"/><TextBlock Text="Cross connection" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="22" Height="5" Fill="#A0692D" VerticalAlignment="Center"/><TextBlock Text="Gravel road" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Line X1="0" X2="22" Y1="3" Y2="3" Stroke="#E63228" StrokeThickness="2" StrokeDashArray="2 1.5" Width="22" Height="6" VerticalAlignment="Center"/><TextBlock Text="Cut" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="22" Height="8" Fill="#F5F0E1" Stroke="#3C3228" StrokeThickness="1.5" VerticalAlignment="Center"/><TextBlock Text="Bridge" Margin="8,0,0,0"/></StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="12" Height="12" Stroke="#FACD00" StrokeThickness="2.5" Margin="5,0"/><TextBlock Text="Junction" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="12" Height="12" Stroke="#E600C8" StrokeThickness="2.5" Margin="5,0"/><TextBlock Text="Crossing" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="10" Height="10" Fill="#F58C00" Margin="6,0"/><TextBlock Text="Dead end" Margin="8,0,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2"><Rectangle Width="14" Height="14" Fill="#46146EDC" Stroke="#146EDC" StrokeThickness="2" StrokeDashArray="2 1" Margin="4,0"/><TextBlock Text="Node tile" Margin="8,0,0,0"/></StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FormSection}" Text="Editing the plan"/>
                        <TextBlock Style="{StaticResource FormText}" TextWrapping="Wrap" Margin="2,0,2,0"
                                   Text="• Click a road: change kind or width, delete (Del).&#x0a;• Drag a road, ring or node tile to move it.&#x0a;• Ctrl+Z takes back changes to the plan."/>
                    </StackPanel>
                    <StackPanel x:Name="SpotBox" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FormSection}" Text="Places to check"/>
                        <TextBlock Style="{StaticResource FormNote}" Text="Click a line: the map jumps there and marks the place."/>
                        <StackPanel x:Name="SpotPanel"/>
                    </StackPanel>
                    <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="2,10,2,2" Text="Not planned yet."/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
