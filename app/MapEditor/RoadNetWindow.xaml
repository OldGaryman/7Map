<Window x:Class="MapEditor.RoadNetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="clr-namespace:MapEditor"
        Title="Generate roads" Width="520" Height="640" MinHeight="420" ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <!-- Straßen erzeugen (Wunsch des Nutzers 7.11.2026), Stufe 1: Netz planen und in der Karte zeigen, ohne die Welt zu ändern.
         Fenster bleibt neben der Karte offen (nicht modal), damit man die Vorschau ansehen und neu planen kann. -->
    <DockPanel Margin="20,18,20,16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="250"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True" Click="Close_Click"/>
                <Button x:Name="PlanButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="Plan_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Signpost2}"/><TextBlock Text="Plan network" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <Button x:Name="BuildButton" Style="{StaticResource DialogButton}" FontWeight="SemiBold" IsEnabled="False" Click="Build_Click"
                        ToolTip="Build the planned roads into the map (one editing step, undo with Ctrl+Z)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Hammer}"/><TextBlock Text="Build roads" Margin="6,0,0,0"/></StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource FormTitle}" Text="Roads between the towns"/>
            <Border Style="{StaticResource FormBox}" Margin="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Usual gradient, up to"/>
                        <TextBox x:Name="GradeBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="In tight passages, up to"/>
                        <TextBox x:Name="MaxGradeBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="%"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cut into the ground, up to"/>
                        <TextBox x:Name="CutBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"
                                 ToolTip="Roads may lie this deep below the terrain in a cut"/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Embankment, up to"/>
                        <TextBox x:Name="FillBox" Style="{StaticResource FormField}" TextChanged="Text_Changed"
                                 ToolTip="Roads may lie this high above the terrain on an embankment. Small values keep the roads close to the ground. Steep terrain still needs more."/>
                        <TextBlock Style="{StaticResource FormUnit}" Text="m"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cross connections"/>
                        <ComboBox x:Name="LoopsBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="Extra roads where the way over the network would be a long detour; they create crossings and junctions">
                            <ComboBoxItem Content="Few"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Many"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Curviness"/>
                        <ComboBox x:Name="CurvesBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="How much the roads swing in wide bends on flat land (in hills they follow the terrain anyway)">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Normal"/>
                            <ComboBoxItem Content="Strong"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Cuts through ridges"/>
                        <ComboBox x:Name="CutsBox" Style="{StaticResource FormCombo}" SelectionChanged="Selection_Changed"
                                  ToolTip="Some roads go straight through a ridge in a cut (up to about 20 m deep) instead of winding around it">
                            <ComboBoxItem Content="Never"/>
                            <ComboBoxItem Content="Rarely"/>
                            <ComboBoxItem Content="More often"/>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}">
                        <TextBlock Style="{StaticResource FormLabelWide}" Text="Seed"/>
                        <TextBox x:Name="SeedBox" Width="150" Height="{StaticResource FormControlHeight}" VerticalContentAlignment="Center" Padding="3,0" DockPanel.Dock="Left" TextChanged="Text_Changed"/>
                        <Button Style="{StaticResource FormButton}" Click="RandomSeed_Click" ToolTip="New random seed – same seed on the same map = same network">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconText}" Text="{x:Static ic:Icons.Dice5}"/><TextBlock Text="Random" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource FormNote}" Text="Asphalt roads 16 m wide with a 1 m gravel shoulder on each side; Old West towns get a gravel road (as wide as their exit, at most 12 m). &quot;Plan network&quot; only shows the network on the map; &quot;Build roads&quot; then builds it into the map (undo with Ctrl+Z)."/>
            <TextBlock Style="{StaticResource FormTitle}" Margin="0,14,0,6" Text="Result"/>
        </StackPanel>

        <Border Style="{StaticResource FormBox}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="2" Text="Not planned yet."/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
