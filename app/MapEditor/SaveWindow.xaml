<Window x:Class="MapEditor.SaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy map changes into a save" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- Apply map changes to an existing save game (the user's request 2026-10-30): first preview, then apply -->
    <StackPanel Margin="{StaticResource WindowPadding}">
        <TextBlock Style="{StaticResource FormIntro}"
                   Text="Areas you have already visited are stored in the save and never rebuilt from the map. YAMEE resets the stored areas in which the map has changed and copies the map into the game, so the game rebuilds them from the new map."/>

        <TextBlock Style="{StaticResource FormTitle}" Text="Save game"/>
        <ComboBox x:Name="SaveBox"/>
        <TextBlock x:Name="NoSaveText" Style="{StaticResource FormNote}" Foreground="{DynamicResource ErrorBrush}" Visibility="Collapsed"
                   Text="No save for this world was found. Start a game on this world first."/>

        <TextBlock Style="{StaticResource FormTitle}" Margin="0,14,0,6" Text="Compare with"/>
        <TextBlock x:Name="ReferenceText" Style="{StaticResource FormText}" Text=""/>

        <Button x:Name="PreviewButton" Style="{StaticResource DialogButton}" Content="Calculate preview" Margin="0,12,0,0" HorizontalAlignment="Left"/>
        <Border x:Name="ResultBox" Style="{StaticResource FormBox}" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Text=""/>
                <TextBlock x:Name="WarnText" Style="{StaticResource FormNote}" Foreground="{DynamicResource ErrorBrush}"
                           Text="In the areas marked red on the map, everything built or changed in the game is lost (the save is backed up completely first)."/>
            </StackPanel>
        </Border>
        <TextBlock x:Name="StatusText" Style="{StaticResource FormNote}" Text=""/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource DialogFooterMargin}">
            <Button Style="{StaticResource DialogButton}" Content="Close" IsCancel="True"/>
            <Button x:Name="ApplyButton" Style="{StaticResource DialogButton}" Content="Copy into save" FontWeight="SemiBold" IsEnabled="False"/>
        </StackPanel>
    </StackPanel>
</Window>
