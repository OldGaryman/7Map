<Window x:Class="MapEditor.BridgeAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add bridge kit" Width="760" Height="600" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- a kit of another mod, chosen by hand (the user's decision 2026-11-24): end piece and middle piece, or one piece -->
    <DockPanel Margin="{StaticResource WindowPadding}">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormTitle}" Text="Add bridge kit"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormIntro}"
                   Text="Choose the end piece of the bridge on the left and the middle piece on the right (the piece that is lined up over the river). A bridge of one piece has no middle piece. The pieces must be in the game or in its Mods folder."/>
        <DockPanel DockPanel.Dock="Top" Style="{StaticResource FormRowFill}">
            <TextBlock Style="{StaticResource FormLabel}" Text="Search"/>
            <TextBox x:Name="FilterBox" Style="{StaticResource FormField}" Width="Auto" TextAlignment="Left" ToolTip="Part of the name, e.g. bridge"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="{StaticResource DialogFooterMargin}" LastChildFill="False">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Analyse and add" FontWeight="SemiBold" IsDefault="True" IsEnabled="False"/>
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Cancel" IsCancel="True"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Style="{StaticResource FormRowFill}" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource FormLabel}" Text="Name in the list"/>
            <TextBox x:Name="LabelBox" Style="{StaticResource FormField}" Width="Auto" TextAlignment="Left"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormSection}" Margin="0,4,0,4" Text="End piece"/>
                <ListBox x:Name="EndList" Style="{StaticResource ListBorder}"/>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormSection}" Margin="0,4,0,4" Text="Middle piece"/>
                <ListBox x:Name="TileList" Style="{StaticResource ListBorder}"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
