<Window x:Class="MapEditor.SwapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Swap building" Width="480" Height="660" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- choice of the buildings that fit the lot of the city tile exactly (the user's request) -->
    <DockPanel Margin="12">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Text=""/>
        <TextBlock x:Name="RuleText" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,4,0,8" Text=""/>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Padding="4,2" Margin="0,0,0,8" ToolTip="Filter by name"/>
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
            <Button x:Name="SwapButton" Content="Swap" Padding="10,4" Margin="0,0,4,0" FontWeight="SemiBold" IsDefault="True" IsEnabled="False"/>
            <Button Content="Cancel" Padding="10,4" Margin="4,0,0,0" IsCancel="True"/>
        </UniformGrid>
        <TextBlock DockPanel.Dock="Bottom" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Double-click also swaps. The new building gets the direction and height of the lot; its driveways come along. Undo with Ctrl+Z."/>
        <ListBox x:Name="CandidateList" BorderBrush="{DynamicResource SoftLineBrush}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"/>
    </DockPanel>
</Window>
