<Project Sdk="Microsoft.NET.Sdk">

  <!-- Automatic tests of YAMEE: a console program without extra packages (works offline).
       Start: run_tests.bat in the project folder, or in Visual Studio set YAMEE.Tests as startup project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YameeTests</RootNamespace>
    <AssemblyName>YAMEE.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapEditor\MapEditor.csproj" />
  </ItemGroup>

</Project>
